# No Brakes dialer - copy to .env and fill in. .env is gitignored.
# Every value here can place billable calls or mutate the CRM. Never commit .env.

# --- Twilio ---
# Account SID starts with AC. This is NOT the API key.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Key SID starts with SK, created under Console > Account > API keys & tokens.
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_key_secret
# TwiML App SID starts with AP. Its Voice URL points at the deployed dial Function.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Outbound caller ID in E.164. Must be a verified outgoing caller ID on a FULL
# (upgraded) Twilio account - trial accounts cannot use a verified number here.
# HARD REFUSAL: +18583564281 is the mystery-shop persona line and is rejected at
# startup. It must never be shared with a prospect.
TWILIO_CALLER_ID=+1xxxxxxxxxx

# --- Airtable ---
# Personal access token, starts with pat. Placeholder uses underscores on purpose:
# the pre-commit hook scans for real-shaped tokens and this must not trip it.
AIRTABLE_API_KEY=pat_REPLACE_ME.REPLACE_ME
AIRTABLE_BASE_ID=appEJYWOrT5NAbxOM
AIRTABLE_TABLE_ID=tblURF0GnyhgKIzJj

# --- Safety flags ---
# 1 = Airtable writes actually happen. 0 = every write is logged and dropped.
# Matches the house pattern (CAL_ARM_WRITE, SDR_ARM_WRITE).
DIALER_ARM_WRITE=0
# 1 = simulate the ring -> outcome cycle. Zero Twilio spend, zero real calls.
DIALER_DRY_RUN=0
